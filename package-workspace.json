{
  "name": "kred-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "."
  ],
  "scripts": {
    "dev:client": "vite",
    "dev:server": "npm run dev --workspace=@kred/server",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build:shared": "npm run build --workspace=@kred/shared",
    "build:server": "npm run build --workspace=@kred/server",
    "build:client": "vite build",
    "build:all": "npm run build:shared && npm run build:server && npm run build:client",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  }
}
