{
  "name": "kred",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "npm run dev --workspace=@kred/server",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "vite build",
    "build:shared": "npm run build --workspace=@kred/shared",
    "build:server": "npm run build --workspace=@kred/server",
    "build:client": "vite build",
    "build:all": "npm run build:shared && npm run build:server && npm run build:client",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@kred/shared": "file:./packages/shared",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.12",
    "jsdom": "^27.2.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.12"
  }
}
