{
  "name": "kred",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared"
  ],
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "build": "vite build",
    "build:shared": "npm run build --workspace=@kred/shared",
    "build:client": "vite build",
    "build:all": "npm run build:shared && npm run build:client",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "playtest": "tsx src/scripts/playtest.ts"
  },
  "dependencies": {
    "@kred/shared": "file:./packages/shared",
    "@supabase/supabase-js": "^2.101.1",
    "i18next": "^25.8.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.12",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.12"
  }
}
